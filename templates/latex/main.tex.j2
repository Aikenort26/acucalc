\begin{tabular}{lrrrr}\toprule
Tanque & Entrada [h/día] & $Q$ entrada [L/s] & Fracción reg. & $V$ asignado [m³] \\ \midrule
\BLOCK{for tb in tanques_balance}
\VAR{tb.nombre} & \VAR{tb.horas} & \VAR{tb.q_entrada} & \VAR{tb.frac} & \VAR{tb.v} \\
\BLOCK{endfor}
\bottomrule\end{tabular}\end{table}
